index 0000000..810bff9
--- /dev/null
+++ b/scripts/test-edit-erase.mjs
@@ -0,0 +1,233 @@
+// Edit-mode erase regression. Synthetic PDF only. Requires the dev server assets (`npm run assets`).
+// Starts its own Vite server unless FOLIO_DEV_URL is already set.
+import assert from "node:assert/strict";
+import { createRequire } from "node:module";
+import { appendFileSync, mkdtempSync, mkdirSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import path from "node:path";
+import { _electron as electron } from "playwright-core";
+import { PDFDocument, StandardFonts, rgb } from "pdf-lib";
+import { createServer } from "vite";
+import { electronPath } from "./electron-path.mjs";
+import { readerPage } from "./reader-page.mjs";
+
+const root = path.resolve(import.meta.dirname, "..");
+const require = createRequire(import.meta.url);
+const shots = path.join(root, "release", "edit-erase");
+const logFile = path.join(shots, "log.txt");
+mkdirSync(shots, { recursive: true });
+rmSync(logFile, { force: true });
+const log = message => { appendFileSync(logFile, message + "\n"); console.log(message); };
+
+const doc = await PDFDocument.create();
+const pdfPage = doc.addPage([320, 240]);
+const font = await doc.embedFont(StandardFonts.Helvetica);
+pdfPage.drawText("BakedHello", { x: 36, y: 180, size: 18, font, color: rgb(0, 0, 0) });
+pdfPage.drawText("DropMe", { x: 180, y: 180, size: 18, font, color: rgb(0, 0, 0) });
+pdfPage.drawText("KeepMe", { x: 36, y: 40, size: 14, font, color: rgb(0, 0, 0) });
+const form = doc.getForm();
+const field = form.createTextField("synth.field");
+field.setText("FormHello");
+field.addToPage(pdfPage, { x: 36, y: 100, width: 160, height: 22, font, textColor: rgb(0, 0, 0) });
+const png = Buffer.from("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mP8z8BQDwAEhQGAhKmMIQAAAABJRU5ErkJggg==", "base64");
+const embedded = await doc.embedPng(png);
+pdfPage.drawImage(embedded, { x: 200, y: 120, width: 36, height: 36 });
+pdfPage.drawImage(embedded, { x: 250, y: 120, width: 36, height: 36 });
+const pdf = Buffer.from(await doc.save());
+
+let server;
+const devUrl = process.env.FOLIO_DEV_URL;
+if (!devUrl) {
+  server = await createServer({ root, server: { host: "127.0.0.1", port: 0, strictPort: false } });
+  await server.listen();
+}
+const origin = devUrl ? new URL(devUrl).origin : server.resolvedUrls.local[0].replace(/\/$/, "");
+const env = {
+  ...process.env,
+  FOLIO_DEV_URL: origin,
+  FOLIO_TEST_HIDDEN: process.env.FOLIO_SHOW_APP === "1" ? "0" : "1",
+  FOLIO_TEST_USER_DATA: mkdtempSync(path.join(tmpdir(), "folio-edit-erase-")),
+};
+delete env.ELECTRON_RUN_AS_NODE;
+const app = await electron.launch({
+  executablePath: electronPath(env),
+  args: [root, "--mute-audio", ...(process.getuid?.() === 0 ? ["--no-sandbox"] : [])],
+  env,
+  timeout: 60_000,
+});
+const hardStop = setTimeout(() => {
+  console.error("edit-erase test timed out");
+  process.exit(1);
+}, 180_000);
+try {
+  const ui = readerPage(await app.firstWindow());
+  ui.window.setDefaultTimeout(20_000);
+  const failures = [];
+  ui.on("pageerror", error => { const text = String(error); failures.push(text); log("pageerror " + text); });
+  ui.on("console", msg => { if (msg.type() === "error") log("console " + msg.text()); });
+  await ui.getByRole("button", { name: /Try a sample/ }).waitFor();
+  await app.evaluate(({ BrowserWindow }, b64) => {
+    BrowserWindow.getAllWindows()[0].webContents.send("folio:open-file", {
+      name: "synthetic-erase.pdf", data: Buffer.from(b64, "base64"),
+    });
+  }, pdf.toString("base64"));
+  await ui.window.waitForFunction(() => document.title.startsWith("synthetic-erase.pdf"));
+  const sheet = ui.locator('.page[data-page-number="1"]');
+  const textOf = async () => (await sheet.locator(".textLayer").innerText()).replace(/\s+/g, " ").trim();
+  await sheet.locator(".textLayer").getByText("BakedHello", { exact: true }).waitFor();
+  const editButton = ui.getByRole("button", { name: "Edit mode", exact: true });
+  await editButton.click();
+  let entered = await ui.getByRole("button", { name: "Exit edit mode", exact: true }).waitFor({ timeout: 8_000 }).then(() => "mouse").catch(() => "");
+  log("edit mode after mouse click: " + (entered || "not entered"));
+  if (!entered) {
+    const dom = await ui.evaluate(() => {
+      const target = [...document.querySelectorAll("button")].find(button =>
+        (button.getAttribute("aria-label") || button.textContent || "").trim() === "Edit mode");
+      if (!target) return { found: false };
+      target.click();
+      return { found: true, pressed: target.getAttribute("aria-pressed") };
+    });
+    log("dom click: " + JSON.stringify(dom));
+    entered = await ui.getByRole("button", { name: "Exit edit mode", exact: true }).waitFor({ timeout: 8_000 }).then(() => "dom").catch(() => "");
+    log("edit mode after dom click: " + (entered || "not entered"));
+  }
+  if (!entered) {
+    const toast = await ui.locator(".toast").innerText().catch(() => "");
+    log("toast: " + JSON.stringify(toast));
+    await ui.screenshot({ path: path.join(shots, "edit-mode-did-not-start.png") }).catch(() => {});
+    throw new Error("Edit mode did not start. Mouse click and DOM click both left the button unpressed.");
+  }
+  log("entered edit mode via " + entered);
+  const input = sheet.getByRole("textbox", { name: "Edit text on page" });
+  const item = name => sheet.getByRole("button", { name, exact: true });
+  const openItem = async name => {
+    log("open " + name);
+    const button = item(name);
+    try {
+      await button.waitFor({ timeout: 45_000 });
+    } catch (error) {
+      const status = await ui.locator(".folio-edit-status").innerText().catch(() => "");
+      const labels = await sheet.locator(".folio-content-target").evaluateAll(els => els.map(el => el.getAttribute("aria-label"))).catch(() => []);
+      const pressed = await ui.getByRole("button", { name: /edit mode/i }).first().getAttribute("aria-pressed").catch(() => "");
+      log("edit status: " + JSON.stringify(status) + " pressed: " + pressed + " labels: " + JSON.stringify(labels));
+      throw error;
+    }
+    await button.click({ timeout: 15_000, force: true });
+    await input.waitFor({ timeout: 15_000 });
+  };
+
+  await ui.locator(".viewer-container").click({ position: { x: 6, y: 6 } });
+  const title = await ui.title();
+  await ui.keyboard.press("Backspace");
+  await ui.keyboard.press("Delete");
+  assert.equal(await ui.title(), title, "Backspace left the document");
+  assert.match(await textOf(), /BakedHello/);
+  assert.match(await textOf(), /KeepMe/);
+
+  await openItem("BakedHello");
+  const opened = await input.evaluate(el => ({
+    active: document.activeElement === el,
+    value: el.value,
+    start: el.selectionStart,
+    end: el.selectionEnd,
+  }));
+  assert.deepEqual(opened, { active: true, value: "BakedHello", start: 10, end: 10 });
+  await ui.screenshot({ path: path.join(shots, "caret-at-end.png") });
+  await input.press("Backspace");
+  assert.equal(await input.inputValue(), "BakedHell");
+  await input.press("ArrowLeft");
+  await input.press("Delete");
+  assert.equal(await input.inputValue(), "BakedHel");
+  await input.press("Enter");
+  await sheet.locator(".textLayer").getByText("BakedHel", { exact: true }).waitFor();
+  assert.match(await textOf(), /KeepMe/);
+  assert.match(await textOf(), /DropMe/);
+  assert.doesNotMatch(await textOf(), /BakedHello|BakedHell(?!o)/);
+  await ui.screenshot({ path: path.join(shots, "committed-two-characters.png") });
+
+  await openItem("BakedHel");
+  await input.press("ControlOrMeta+a");
+  await input.press("Backspace");
+  assert.equal(await input.inputValue(), "");
+  assert.match(await textOf(), /BakedHel/, "clearing the field hides the preview but must not pretend the PDF changed before Enter");
+  await input.press("Enter");
+  await sheet.locator(".textLayer").getByText("BakedHel", { exact: true }).waitFor({ state: "detached", timeout: 15_000 });
+  const afterClear = await textOf();
+  assert.doesNotMatch(afterClear, /BakedHel/);
+  assert.match(afterClear, /KeepMe/);
+  assert.match(afterClear, /DropMe/);
+  await item("Image 1").waitFor();
+  await ui.screenshot({ path: path.join(shots, "line-removed.png") });
+
+  await openItem("DropMe");
+  await ui.getByRole("button", { name: "Remove line", exact: true }).click();
+  await sheet.locator(".textLayer").getByText("DropMe", { exact: true }).waitFor({ state: "detached", timeout: 15_000 });
+  const afterRemove = await textOf();
+  assert.doesNotMatch(afterRemove, /DropMe/);
+  assert.match(afterRemove, /KeepMe/);
+  await item("Image 1").waitFor();
+  await item("Image 2").waitFor();
+  await ui.screenshot({ path: path.join(shots, "remove-line.png") });
+
+  const openImage = async name => {
+    log("open image " + name);
+    await item(name).click({ timeout: 15_000, force: true });
+    await ui.getByRole("button", { name: "Remove image", exact: true }).waitFor({ timeout: 10_000 });
+    await ui.getByRole("button", { name: "Replace image…", exact: true }).waitFor();
+  };
+  await openImage("Image 1");
+  await ui.keyboard.press("Escape");
+  assert.equal(await ui.getByRole("button", { name: "Remove image", exact: true }).count(), 0);
+  await openImage("Image 1");
+  const removed = await ui.evaluate(() => {
+    const button = [...document.querySelectorAll("button")].find(item => item.textContent === "Remove image");
+    if (!button) return false;
+    button.click();
+    return true;
+  });
+  assert.equal(removed, true);
+  const imageCount = () => sheet.locator('button[data-kind="image"]').count();
+  await ui.waitForFunction(() => document.querySelectorAll('.page[data-page-number="1"] button[data-kind="image"]').length === 1);
+  assert.equal(await imageCount(), 1);
+  assert.match(await textOf(), /KeepMe/);
+  await ui.getByRole("button", { name: "Exit edit mode", exact: true }).click();
+  await ui.getByRole("button", { name: "Edit mode", exact: true }).click();
+  await ui.getByRole("button", { name: "Exit edit mode", exact: true }).waitFor();
+  await ui.waitForFunction(() => document.querySelectorAll('.page[data-page-number="1"] button[data-kind="image"]').length === 1);
+  assert.equal(await imageCount(), 1, "image removal did not survive leaving and re-entering Edit mode");
+  assert.match(await textOf(), /KeepMe/);
+  await openImage("Image 1");
+  await ui.keyboard.press("Delete");
+  await ui.waitForFunction(() => document.querySelectorAll('.page[data-page-number="1"] button[data-kind="image"]').length === 0);
+  assert.match(await textOf(), /KeepMe/);
+  await ui.screenshot({ path: path.join(shots, "images-removed.png") });
+
+  await ui.getByRole("button", { name: "Exit edit mode", exact: true }).click();
+  const box = sheet.locator(".annotationLayer input, .annotationLayer textarea");
+  assert.equal(await box.count(), 1);
+  assert.equal(await box.inputValue(), "FormHello");
+  await box.click();
+  await box.press("End");
+  await box.press("Backspace");
+  assert.equal(await box.inputValue(), "FormHell");
+
+  await ui.getByRole("button", { name: "Text", exact: true }).click();
+  await sheet.locator(".annotationEditorLayer").click({ position: { x: 80, y: 80 } });
+  const editor = ui.locator('.freeTextEditor .internal[contenteditable="true"]');
+  await editor.waitFor();
+  await editor.fill("BoxHi");
+  await editor.press("Backspace");
+  assert.equal((await editor.innerText()).replace(/\n/g, ""), "BoxH");
+  await ui.screenshot({ path: path.join(shots, "text-box.png") });
+
+  assert.deepEqual(failures, []);
+  log("ok  edit mode backspace, delete, remove line, form field, and text box");
+} catch (error) {
+  log("FAIL " + (error && error.stack ? error.stack : error));
+  process.exitCode = 1;
+} finally {
+  clearTimeout(hardStop);
+  setTimeout(() => process.exit(process.exitCode ?? 0), 4_000).unref();
+  await Promise.race([app.close().catch(() => {}), new Promise(resolve => setTimeout(resolve, 2_000))]);
+  if (server) await Promise.race([server.close(), new Promise(resolve => setTimeout(resolve, 2_000))]);
+}
